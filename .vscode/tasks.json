{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LaTeX: Build main.pdf",
      "type": "process",
      "command": "latexmk",
      "args": [
        "-cd",
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-halt-on-error",
        "${workspaceFolder}/doc/main.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "latex",
        "source": "LaTeX",
        "fileLocation": ["relative", "${workspaceFolder}/doc"],
        "pattern": {
          "regexp": "^(.+):(\\d+):\\s*(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      }
    }
  ]
}
